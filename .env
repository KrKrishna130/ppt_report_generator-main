# Application
APP_NAME=PPT Generation Pipeline
API_PREFIX=/v1
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis and queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=ppt_jobs

# Temporal setup
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ppt_generation
TEMPORAL_WORKFLOW_TIMEOUT_HOURS=4

# Temporal payload offloading threshold in bytes
# 16384 bytes = 16 KiB.
# Larger payloads are stored in MinIO automatically.
# Set 0 to store every payload in MinIO.
# Current modified code accepts values from 0 to 16384.
# This does not limit generated PPT size or MinIO object size.
TEMPORAL_PAYLOAD_INLINE_BYTES=16384

# MinIO storage
# Docker Compose overrides this endpoint to minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pptadmin   #username
MINIO_SECRET_KEY=change-this-minio-password #password
MINIO_SECURE=false

# Separate buckets for Temporal payloads and generated files
MINIO_PAYLOAD_BUCKET=ppt-temporal-payloads
MINIO_OUTPUT_BUCKET=ppt-generated

# Local working directories used during rendering and QA
# Completed outputs are also uploaded to MinIO.
OUTPUT_DIR=./generated
TEMP_DIR=./tmp

# Job metadata and idempotency retention
JOB_TTL_HOURS=24
IDEMPOTENCY_TTL_MIN=60

# Existing file-retention setting
# Does not configure automatic MinIO object expiration.
FILE_TTL_HOURS=24

# Input and token limits
# Maximum input characters: 50 lakh
MAX_INPUT_CHARS=5000000
MAX_INPUT_TOKENS=100000
MAX_UPLOAD_MB=20

# Input chunking
WINDOW_TOKENS=3000
WINDOW_OVERLAP_MSGS=1
CHUNK_TOKENS=3000

# Slide generation settings
SLIDES_MIN=1
SLIDES_MAX=50
DEFAULT_SLIDE_COUNT=5
MAX_OUTPUT_SLIDES=50

# Concurrency
# SLIDE_CONCURRENCY affects worker activity capacity.
# Workflow slide-builder batches are separately capped at 20.
# LLM_CONCURRENCY controls model requests per worker process.
SLIDE_CONCURRENCY=1
LLM_CONCURRENCY=1

# Build and quality assurance
BUILD_RETRIES=1
QA_MAX_ROUNDS=1
QA_CONCURRENCY=1
MAX_CHART_COUNT=8

# GLM model configuration
GLM_BASE_URL=http://host.docker.internal:8001/v1
GLM_API_KEY=not-needed
GLM_MODEL=glm

# Gemma model configuration
GEMMA_BASE_URL=http://host.docker.internal:11434/v1
GEMMA_API_KEY=not-needed
GEMMA_MODEL=gemma3:4b
GEMMA_VISION_MODEL=gemma3:4b

# LLM request settings
# Timeout per model request: 10 minutes
LLM_TIMEOUT_SECONDS=600
LLM_RETRIES=1

# Planner settings
PLANNER_TEMPERATURE=0.1
PLANNER_MAX_TOKENS=2000

# Parser settings
PARSER_MAX_TOKENS=500

# Digest settings
DIGEST_MAX_TOKENS=1200

# Builder settings
BUILDER_TEMPERATURE=0.2
BUILDER_MAX_TOKENS=1200

# Review settings
REVIEW_MAX_TOKENS=800

# QA settings
QA_MAX_TOKENS=800
MIN_QUALITY_SCORE=0
MIN_CONTRAST=4.5

# Output features
ENABLE_VISUAL_QA=false
ENABLE_PDF_EXPORT=true
ENABLE_THUMBNAILS=true
# this is Uses automatic background matching. Enabled in the supplied ZIP.
ENABLE_THEME_BACKGROUND_MATCHING=true

# Shared slide-content cache
# Independent of request/user IDs when cache inputs match.
CONTENT_CACHE_ENABLED=true

# Cache lifetime: 365 days
CONTENT_CACHE_TTL_HOURS=8760