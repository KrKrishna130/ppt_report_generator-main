# Bare-metal settings for pptctl. install.sh copies this to ppt.env; edit ppt.env, then: ./pptctl restart
# App settings (models, slide limits, ...) stay in .env; values here override .env for this host.

# OpenAI-compatible LLM servers already running on (or reachable from) this machine.
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GLM_BASE_URL=http://127.0.0.1:8001/v1

# Interface for the user-facing ports (API, dashboard, Temporal UI, Grafana, Prometheus).
# Use 127.0.0.1 to keep everything local to this machine.
PUBLIC_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=5173
TEMPORAL_UI_PORT=8233
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Local-only ports (127.0.0.1) for Redis and Temporal; change them if something on this host already uses them.
REDIS_PORT=6379
TEMPORAL_PORT=7233

# Browser origins allowed to call the API (the dashboard's address). install.sh adds this host's
# names and IPs; add more as http://<name>:5173, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = also run the monitoring stack (OTel collector, Jaeger, Prometheus, Loki, Grafana).
# 0 = app only; telemetry export is switched off.
ENABLE_OBSERVABILITY=1
