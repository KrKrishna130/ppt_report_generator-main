# Pinned versions for the air-gapped bundles. Sourced by airgap/build_bundle.sh.
# Docker images and bare-metal binaries use the same upstream versions.

# --- Docker images (pulled on the online machine, saved into the bundle) ---
IMG_REDIS=redis:7.4.8-alpine
IMG_TEMPORAL=temporalio/temporal:1.9.1
IMG_OTEL=otel/opentelemetry-collector-contrib:0.120.0
IMG_JAEGER=jaegertracing/jaeger:2.2.0
IMG_PROMETHEUS=prom/prometheus:v3.1.0
IMG_LOKI=grafana/loki:3.3.2
IMG_GRAFANA=grafana/grafana:11.4.0
# Built from this repo; the tag is the git commit (see build_bundle.sh).
IMG_APP_REPO=ppt-report-generator
IMG_DASHBOARD_REPO=ppt-api-dashboard

# --- Bare-metal (Linux x86_64) downloads ---
PY_TAG=20261013
PY_FILE=cpython-3.12.15+${PY_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz
PY_URL=https://github.com/astral-sh/python-build-standalone/releases/download/${PY_TAG}/${PY_FILE}

REDIS_VER=7.4.8
REDIS_FILE=redis-${REDIS_VER}.tar.gz
REDIS_URL=https://download.redis.io/releases/${REDIS_FILE}
# redis-server is compiled from source in this image so it runs on glibc >= 2.28 (RHEL 8, Ubuntu 20.04+).
REDIS_BUILD_IMAGE=almalinux:8

TEMPORAL_VER=1.9.1
TEMPORAL_FILE=temporal_cli_${TEMPORAL_VER}_linux_amd64.tar.gz
TEMPORAL_URL=https://github.com/temporalio/cli/releases/download/v${TEMPORAL_VER}/${TEMPORAL_FILE}

OTEL_VER=0.120.0
OTEL_FILE=otelcol-contrib_${OTEL_VER}_linux_amd64.tar.gz
OTEL_URL=https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${OTEL_VER}/${OTEL_FILE}

# Jaeger v2.2.0 binaries are published under the v1.65.0 GitHub release.
JAEGER_VER=2.2.0
JAEGER_FILE=jaeger-${JAEGER_VER}-linux-amd64.tar.gz
JAEGER_URL=https://github.com/jaegertracing/jaeger/releases/download/v1.65.0/${JAEGER_FILE}

PROM_VER=3.1.0
PROM_FILE=prometheus-${PROM_VER}.linux-amd64.tar.gz
PROM_URL=https://github.com/prometheus/prometheus/releases/download/v${PROM_VER}/${PROM_FILE}

LOKI_VER=3.3.2
LOKI_FILE=loki-${LOKI_VER}-linux-amd64.zip
LOKI_URL=https://github.com/grafana/loki/releases/download/v${LOKI_VER}/loki-linux-amd64.zip

GRAFANA_VER=11.4.0
GRAFANA_FILE=grafana-${GRAFANA_VER}.linux-amd64.tar.gz
GRAFANA_URL=https://dl.grafana.com/oss/release/${GRAFANA_FILE}

FONTS_FILE=liberation-fonts-ttf-2.1.5.tar.gz
FONTS_URL=https://github.com/liberationfonts/liberation-fonts/files/7261482/${FONTS_FILE}

# --- API docs assets (/docs, /redoc), fetched into app/static/docs by fetch_docs_assets.sh ---
SWAGGER_UI_VER=5.33.3
SWAGGER_UI_SHA512=7xJKxAjf+/ajlW/V/dMfbiY+NC5BWtbvzzdI/AsX5UzMtOMudmFz/tjuKN0jN7QVe5drKKnx01CdYEJvTFvQlw==
REDOC_VER=2.5.4
REDOC_SHA512=M6jWhG1qoBnH6TFmzJnstyCZ87HmOY/UzDm78mHiYihEdlV/YcS9ogOo1NlElnJMeLsyxHFe2yFc4sNjHTrABQ==
